DISCORD_TOKEN=replace-me
# Optional: register commands instantly in one development server.
# DISCORD_GUILD_ID=123456789012345678
DATABASE_URL=sqlite://data/jackson.db?mode=rwc
IDLE_DISCONNECT_SECS=300
MAX_PLAYLIST_TRACKS=100
# Optional single-line YouTube Cookie header value. Jackson securely converts it
# to the Netscape cookie jar format required by yt-dlp.
# YTDLP_COOKIES=replace-me
# Alternative: path inside the container to a Netscape cookie file.
# YTDLP_COOKIES_FILE=/run/secrets/youtube_cookies
RUST_LOG=jackson=info,songbird=warn,serenity=warn

# Docker Compose deployment settings. Pin production to a released version.
JACKSON_IMAGE_TAG=0.1.2
JACKSON_CPUS=2.0
JACKSON_MEMORY_LIMIT=2g
JACKSON_MEMORY_RESERVATION=256m
